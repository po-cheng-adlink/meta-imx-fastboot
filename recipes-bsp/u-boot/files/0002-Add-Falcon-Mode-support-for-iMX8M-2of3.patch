 board/freescale/imx8mm_evk/spl.c | 14 ++++++++++++++
 board/freescale/imx8mn_evk/spl.c | 14 ++++++++++++++
 board/freescale/imx8mp_evk/spl.c | 14 ++++++++++++++
 include/configs/imx8mm_evk.h     |  2 ++
 include/configs/imx8mn_evk.h     |  2 ++
 include/configs/imx8mp_evk.h     |  2 ++
 6 files changed, 48 insertions(+)

diff --git a/board/freescale/imx8mm_evk/spl.c b/board/freescale/imx8mm_evk/spl.c
index c93fbd42ed6c..05a59f501cb8 100644
--- a/board/freescale/imx8mm_evk/spl.c
+++ b/board/freescale/imx8mm_evk/spl.c
@@ -32,9 +32,23 @@
 #include <mmc.h>
 #include <linux/delay.h>
 #include <fsl_sec.h>
+#include <serial.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
+#ifdef CONFIG_SPL_OS_BOOT
+int spl_start_uboot(void) {
+	if (IS_ENABLED(CONFIG_SPL_SERIAL) && serial_tstc() && serial_getc()) {
+	/* break into full u boot if any key is pressed */
+		while(serial_tstc()) { /* eat up all the remaining characters */
+			serial_getc();
+		}
+		return 1;
+	}
+	return 0; // start the Kernel
+}
+#endif
+
 int spl_board_boot_device(enum boot_device boot_dev_spl)
 {
 	switch (boot_dev_spl) {
